# Copy to .env and fill in. Never commit .env.

# --- GitHub ---
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-string
TRIGGER_LABEL=devin-ready
ALLOWED_REPOS=cjada/superset

# --- Devin (organization API, service-user auth) ---
DEVIN_API_BASE=https://api.devin.ai
DEVIN_API_KEY=
DEVIN_ORG_ID=org-...
# Optional: attribute sessions to a human user (needs ImpersonateOrgSessions)
# DEVIN_CREATE_AS_USER_ID=user-...
# Optional guardrail
# DEVIN_MAX_ACU_LIMIT=30
DEVIN_SESSION_TAGS=issue-remediator

# --- Behaviour ---
# DRY_RUN=true simulates Devin; set to false to call the real Devin API.
DRY_RUN=true
POLL_INTERVAL_SECONDS=60
DATABASE_URL=sqlite:///./data/remediator.db
